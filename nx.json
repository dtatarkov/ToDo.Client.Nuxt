{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  
  "targetDefaults": {
    "test": {
      "cache": true
    },

    "lint": {
      "cache": true
    },

    "typecheck": {
      "cache": true
    }
  },

  "sync": {
    "disabledTaskSyncGenerators": ["@nx/js:typescript-sync"]
  },

  "tui": {
    "autoExit": true
  },

  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      
      "options": {
        "targetName": "lint"
      }
    },    

    {
      "plugin": "@nx/nuxt/plugin",

      "options": {
        "buildTargetName": "build",
        "testTargetName": "test",
        "serveTargetName": "serve",
        "buildStaticTargetName": "nuxt-build-static",
        "serveStaticTargetName": "nuxt-serve-static"
      }
    },
    
    {
      "plugin": "@nx/vitest",
      "exclude": ["client.nuxt"],

      "options": {        
        "testTargetName": "test",
        "testMode": "run"
      }
    }
  ],

  "pluginsConfig": {
    "@nx/workspace": {
      "enforceModuleBoundary": {
        "enabled": false
      }
    }
  },

  "analytics": false
}

{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  
  "targetDefaults": {
    "test": {
      "cache": true
    },

    "lint": {
      "cache": true
    },

    "lint:fix": {
      "cache": true
    }
  },

  "sync": {
    "disabledTaskSyncGenerators": ["@nx/js:typescript-sync"]
  },

  "tui": {
    "autoExit": true
  },

  "plugins": [
    {
      "plugin": "@nx/js/typescript",

      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },

        "build": false
      }
    },

    {
      "plugin": "@nx/eslint/plugin",
      
      "options": {
        "targetName": "lint"
      }
    }
  ],

  "pluginsConfig": {
    "@nx/workspace": {
      "enforceModuleBoundary": {
        "enabled": false
      }
    }
  },

  "analytics": false
}

{
  "name": "@client",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nx run client:dev",
    "build": "nx run client:build",
    "generate": "nx run client:generate",
    "preview": "nx run client:preview",
    "postinstall": "nx run client:postinstall",
    "storybook": "nx run client:storybook",
    "build-storybook": "nx run client:build-storybook",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint:fix",
    "precommit": "nx run-many --targets=typecheck,lint:fix,test",
    "prepare": "pnpm --filter client.nuxt prepare"
  },
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017",
  "devDependencies": {
    "@nx/js": "^23.0.1",
    "eslint": "9.29.0",
    "nx": "23.0.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
